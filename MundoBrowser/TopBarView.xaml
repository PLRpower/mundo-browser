<UserControl x:Class="MundoBrowser.TopBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="1200">
    
    <Border Background="Transparent" Height="40">
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <!-- Col 0: Navigation Buttons (Matches Sidebar Width) -->
                <ColumnDefinition Width="{Binding SidebarWidth}" MinWidth="140"/>
                <ColumnDefinition Width="5"/>
                <!-- Col 2: URL Bar -->
                <ColumnDefinition Width="1.5*"/>
                <!-- Col 3: Spacer -->
                <ColumnDefinition Width="*"/>
                <!-- Col 4: AdBlocker -->
                <ColumnDefinition Width="Auto"/>
                <!-- Col 5: Extensions -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Nav Buttons -->
            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="12,0,15,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Button Width="30" Height="30" Style="{StaticResource NavButtonStyle}" Click="Back_Click">
                    <Viewbox Width="16" Height="16">
                        <Path Data="{StaticResource IconLeft}" Fill="White" Width="20" Height="20"/>
                    </Viewbox>
                </Button>
                <Button Width="30" Height="30" Style="{StaticResource NavButtonStyle}" Click="Forward_Click">
                    <Viewbox Width="16" Height="16">
                        <Path Data="{StaticResource IconRight}" Fill="White" Width="20" Height="20"/>
                    </Viewbox>
                </Button>
                <Button Width="30" Height="30" Style="{StaticResource NavButtonStyle}" Click="Reload_Click">
                    <Viewbox Width="16" Height="16">
                        <Path Data="{StaticResource IconRefresh}" Fill="White" Width="20" Height="20"/>
                    </Viewbox>
                </Button>
            </StackPanel>

            <!-- URL Box -->
            <Border x:Name="UrlBarBorder" Grid.Column="2" Background="#1E1E1E" CornerRadius="17" Height="34" VerticalAlignment="Center" Margin="0,2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPendingNewTab}" Value="True">
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#007ACC" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <!-- Changement de l'arrondi quand les suggestions sont ouvertes pour faire un bloc unifié -->
                            <DataTrigger Binding="{Binding ElementName=SuggestionsPopup, Path=IsOpen}" Value="True">
                                <Setter Property="CornerRadius" Value="17,17,0,0"/>
                                <Setter Property="BorderThickness" Value="1.5,1.5,1.5,0"/>
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid>
                        <TextBlock Text="Saisir l'adresse du nouvel onglet..."
                                   Foreground="#666" VerticalAlignment="Center" Margin="12,0,0,0"
                                   IsHitTestVisible="False" FontSize="13" FontStyle="Italic">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPendingNewTab}" Value="True"/>
                                                <Condition Binding="{Binding AddressBarText}" Value=""/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="AddressTextBox"
                                 Text="{Binding AddressBarText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="White"
                                 VerticalAlignment="Center" Margin="12,0,15,0" FontSize="14"
                                 CaretBrush="White"
                                 PreviewKeyDown="AddressBar_KeyDown"
                                 TextChanged="AddressTextBox_TextChanged"
                                 GotFocus="AddressTextBox_GotFocus"
                                 LostFocus="AddressTextBox_LostFocus"
                                 PreviewMouseLeftButtonDown="AddressTextBox_PreviewMouseLeftButtonDown"/>
                    </Grid>

                    <!-- Zoom Indicator -->
                    <Button Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,8,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="ResetZoom_Click" ToolTip="Réinitialiser le zoom (Ctrl+0)">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab.ZoomFactor}" Value="1.0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTab.ZoomFactor}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SelectedTab, Converter={StaticResource NullToBoolConverter}, ConverterParameter=invert}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Border Background="#3D3D3D" CornerRadius="10" Padding="8,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding SelectedTab.ZoomPercentage}" FontSize="11" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Popup x:Name="SuggestionsPopup"
                           PlacementTarget="{Binding ElementName=UrlBarBorder}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           VerticalOffset="0">
                        <Border Background="#1E1E1E" BorderBrush="#007ACC" BorderThickness="1.5,0,1.5,1.5"
                                CornerRadius="0,0,17,17" Padding="0,0,0,8"
                                Width="{Binding ActualWidth, ElementName=UrlBarBorder}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" ShadowDepth="4" Direction="270"/>
                            </Border.Effect>
                            <!-- Séparateur visuel subtil entre la barre et la liste -->
                            <Grid>
                                <Border Height="1" Background="#33FFFFFF" VerticalAlignment="Top" Margin="10,0,10,0"/>
                                <ListBox x:Name="SuggestionsListBox"
                                         ItemsSource="{Binding Suggestions}"
                                         Background="Transparent" BorderThickness="0" Foreground="White"
                                         MaxHeight="250" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         PreviewMouseDown="SuggestionsList_PreviewMouseDown"
                                         PreviewKeyDown="SuggestionsList_PreviewKeyDown"
                                         Margin="0,4,0,0">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Height" Value="34"/> <!-- Même hauteur que la barre de recherche -->
                                            <Setter Property="Padding" Value="12,0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemBorder"
                                                                Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#1AFFFFFF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#33007ACC"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="IconBlock" Text="🔗" FontSize="14" Foreground="#AAA" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="0"/>
                                                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center" Grid.Column="1" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="UrlBlock" Text="{Binding Url}" FontSize="12" Foreground="#007ACC" Opacity="0.8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Grid.Column="2"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding VisitCount}" Value="-1">
                                                    <Setter TargetName="IconBlock" Property="Text" Value="🔍"/>
                                                    <Setter TargetName="IconBlock" Property="Foreground" Value="#007ACC"/>
                                                    <Setter TargetName="UrlBlock" Property="Text" Value="Recherche web"/>
                                                    <Setter TargetName="UrlBlock" Property="Foreground" Value="#888"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- AdBlocker -->
            <Button Grid.Column="4" Width="28" Height="28" Margin="10,0,0,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    ToolTip="Boucliers Mundo Browser">
                <Button.ContextMenu>
                    <ContextMenu Background="#2D2D30" Foreground="White" BorderBrush="#3E3E42">
                        <MenuItem Header="Bloqueur de publicités" IsCheckable="True" IsChecked="{Binding IsAdBlockerEnabled}"/>
                        <MenuItem Header="Bloqueur de cookies" IsCheckable="True" IsChecked="{Binding IsCookieBlockerEnabled}"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="4">
                            <TextBlock Text="🛡️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdBlockerEnabled}" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#3D3D3D"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Extensions Icons -->
            <ItemsControl Grid.Column="5" ItemsSource="{Binding InstalledExtensions}" VerticalAlignment="Center" Margin="10,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="28" Height="28" Margin="2,0" Background="Transparent" BorderThickness="0"
                                ToolTip="{Binding Name}" Cursor="Hand" Click="ExtensionIcon_Click" Tag="{Binding Id}">
                            <Button.ContextMenu>
                                <ContextMenu Background="#2D2D30" Foreground="White" BorderBrush="#3E3E42">
                                    <MenuItem Header="Supprimer l'extension" Click="RemoveExtension_Click" Tag="{Binding Id}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="4">
                                        <Grid>
                                            <Image Source="{Binding IconSource}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Style.Triggers><DataTrigger Binding="{Binding IconSource}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Text="🧩" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IconSource}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#3D3D3D"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </Border>
</UserControl>
