<UserControl x:Class="MundoBrowser.TopBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="1200">
    
    <Border Background="Transparent" Height="40">
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <!-- Col 0: Navigation Buttons (Matches Sidebar Width) -->
                <ColumnDefinition Width="{Binding SidebarWidth}" MinWidth="140"/>
                <ColumnDefinition Width="5"/>
                <!-- Col 2: URL Bar -->
                <ColumnDefinition Width="1.75*"/>
                <!-- Col 3: Spacer -->
                <ColumnDefinition Width="*"/>
                <!-- Col 4: Zoom Indicator -->
                <ColumnDefinition Width="Auto"/>
                <!-- Col 5: Site data -->
                <ColumnDefinition Width="Auto"/>
                <!-- Col 6: AdBlocker -->
                <ColumnDefinition Width="Auto"/>
                <!-- Col 7: Extensions -->
                <ColumnDefinition Width="Auto"/>
                <!-- Col 8: Separator before window controls -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Nav Buttons -->
            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="4,0,15,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Button Width="32" Height="32" Style="{StaticResource NavButtonStyle}" Click="Back_Click">
                    <Viewbox Width="19" Height="19">
                        <Path Data="{StaticResource IconLeft}" Fill="White" Width="20" Height="20"/>
                    </Viewbox>
                </Button>
                <Button Width="32" Height="32" Style="{StaticResource NavButtonStyle}" Click="Forward_Click">
                    <Viewbox Width="19" Height="19">
                        <Path Data="{StaticResource IconRight}" Fill="White" Width="20" Height="20"/>
                    </Viewbox>
                </Button>
                <Button Width="32" Height="32" Style="{StaticResource NavButtonStyle}" Click="Reload_Click">
                    <Viewbox Width="19" Height="19">
                        <Path Data="{StaticResource IconRefresh}" Fill="White" Width="20" Height="20"/>
                    </Viewbox>
                </Button>
            </StackPanel>

            <!-- URL Box -->
            <Border x:Name="UrlBarBorder" Grid.Column="2" Background="#1E1E1E" Height="34" VerticalAlignment="Center" Margin="0,2"
                    PreviewMouseLeftButtonDown="UrlBarBorder_PreviewMouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="17"/>
                        <Setter Property="BorderBrush" Value="#333333"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <!-- Changement de l'arrondi quand les suggestions sont ouvertes pour faire un bloc unifié -->
                            <DataTrigger Binding="{Binding IsSuggestionsOpen, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="CornerRadius" Value="17,17,0,0"/>
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPendingNewTab}" Value="True">
                                <Setter Property="BorderBrush" Value="#22C55E"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#22C55E" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid x:Name="AddressBarContent">
                        <Viewbox Width="16"
                                 Height="16"
                                 Margin="11,0,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Path Fill="Transparent"
                                  Stroke="#B8B8B8"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M21,21 L15.803,15.803 M15.803,15.803 A7.5,7.5 0 1 0 5.196,5.196 A7.5,7.5 0 0 0 15.803,15.803 Z"/>
                        </Viewbox>
                        <TextBlock Text="Saisir l'adresse du nouvel onglet..."
                                   Foreground="#666" VerticalAlignment="Center" Margin="36,0,0,0"
                                   IsHitTestVisible="False" FontSize="14" FontStyle="Italic">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPendingNewTab}" Value="True"/>
                                                <Condition Binding="{Binding AddressBarText}" Value=""/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="AddressDisplayTextBlock"
                                   VerticalAlignment="Center"
                                   Margin="36,0,15,0"
                                   FontSize="15"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed">
                            <Run x:Name="AddressPrefixRun" Foreground="#888888"/><Run x:Name="AddressDomainRun" Foreground="White"/><Run x:Name="AddressSuffixRun" Foreground="#888888"/>
                        </TextBlock>
                        <TextBox x:Name="AddressTextBox"
                                 Text="{Binding AddressBarText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="White"
                                 VerticalAlignment="Center" Margin="34,0,15,0" Padding="0" FontSize="15"
                                 CaretBrush="White"
                                 PreviewKeyDown="AddressBar_KeyDown"
                                 TextChanged="AddressTextBox_TextChanged"
                                 GotKeyboardFocus="AddressTextBox_GotKeyboardFocus"
                                 LostKeyboardFocus="AddressTextBox_LostKeyboardFocus"/>
                    </Grid>
                    <!-- Hide the bottom border visually without changing its thickness or moving the input. -->
                    <Border Height="1"
                            Background="#1E1E1E"
                            VerticalAlignment="Bottom"
                            Margin="1,0,1,0"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuggestionsOpen, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <Popup x:Name="SuggestionsPopup"
                           IsOpen="{Binding IsSuggestionsOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=UrlBarBorder}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           VerticalOffset="-1">
                        <Border Background="#1E1E1E" BorderThickness="1,0,1,1"
                                CornerRadius="0,0,17,17" Padding="0,0,0,8"
                                Width="{Binding ActualWidth, ElementName=UrlBarBorder}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#007ACC"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPendingNewTab}" Value="True">
                                            <Setter Property="BorderBrush" Value="#22C55E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Border Height="1"
                                        Background="#33FFFFFF"
                                        VerticalAlignment="Top"
                                        Margin="10,1,10,0"
                                        IsHitTestVisible="False"/>
                                <ListBox x:Name="SuggestionsListBox"
                                         ItemsSource="{Binding Suggestions}"
                                         Background="Transparent" BorderThickness="0" Foreground="White"
                                         MaxHeight="250" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         PreviewMouseDown="SuggestionsList_PreviewMouseDown"
                                         PreviewKeyDown="SuggestionsList_PreviewKeyDown"
                                         Margin="0,4,0,0">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Height" Value="34"/> <!-- Même hauteur que la barre de recherche -->
                                            <Setter Property="Padding" Value="4,0,12,0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemBorder"
                                                                Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#1AFFFFFF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#33007ACC"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Viewbox x:Name="LinkIcon">
                                                        <Path Fill="Transparent"
                                                              Stroke="#AAA"
                                                              StrokeThickness="1.5"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Data="M13.19,8.688 A4.5,4.5 0 0 1 14.432,15.932 L9.932,20.432 A4.5,4.5 0 0 1 3.568,14.068 L5.325,12.311 M18.675,11.689 L20.432,9.932 A4.5,4.5 0 0 0 14.068,3.568 L9.568,8.068 A4.5,4.5 0 0 0 10.81,15.312"/>
                                                    </Viewbox>
                                                    <Viewbox x:Name="SearchSuggestionIcon" Visibility="Collapsed">
                                                        <Path Fill="Transparent"
                                                              Stroke="#B8B8B8"
                                                              StrokeThickness="1.5"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Data="M21,21 L15.803,15.803 M15.803,15.803 A7.5,7.5 0 1 0 5.196,5.196 A7.5,7.5 0 0 0 15.803,15.803 Z"/>
                                                    </Viewbox>
                                                    <Image x:Name="SuggestionFavicon"
                                                           Source="{Binding FaviconUrl}"
                                                           Width="16"
                                                           Height="16"
                                                           Stretch="Uniform"
                                                           Visibility="Collapsed"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center" Grid.Column="1" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="UrlBlock" Text="{Binding Url}" FontSize="12" Foreground="#007ACC" Opacity="0.8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Grid.Column="2"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding VisitCount}" Value="-1">
                                                    <Setter TargetName="LinkIcon" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="SearchSuggestionIcon" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="UrlBlock" Property="Text" Value="Recherche web"/>
                                                    <Setter TargetName="UrlBlock" Property="Foreground" Value="#888"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FaviconUrl, Converter={StaticResource NullToBoolConverter}}" Value="True">
                                                    <Setter TargetName="LinkIcon" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="SuggestionFavicon" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- Zoom Indicator -->
            <Button x:Name="ZoomIndicatorButton"
                    Grid.Column="4" Height="28" Margin="8,0,0,0" Padding="6,4"
                    Style="{StaticResource IconHoverButtonStyle}" Cursor="Hand"
                    Visibility="Collapsed"
                    Click="ResetZoom_Click" ToolTip="Réinitialiser le zoom (Ctrl+0)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectedTab.ZoomPercentage}"
                               FontSize="11"
                               Foreground="White"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Viewbox Width="16" Height="16" Margin="5,0,0,0">
                        <Grid>
                            <Path x:Name="ZoomInIcon"
                                  Fill="White"
                                  Data="M10.5,3.75 A6.75,6.75 0 1 0 10.5,17.25 A6.75,6.75 0 0 0 10.5,3.75 M2.25,10.5 A8.25,8.25 0 1 1 16.84,15.78 L21.53,20.47 A0.75,0.75 0 1 1 20.47,21.53 L15.78,16.84 A8.25,8.25 0 0 1 2.25,10.5 M10.5,6.75 A0.75,0.75 0 0 1 11.25,7.5 L11.25,9.75 L13.5,9.75 A0.75,0.75 0 0 1 13.5,11.25 L11.25,11.25 L11.25,13.5 A0.75,0.75 0 0 1 9.75,13.5 L9.75,11.25 L7.5,11.25 A0.75,0.75 0 0 1 7.5,9.75 L9.75,9.75 L9.75,7.5 A0.75,0.75 0 0 1 10.5,6.75 Z"/>
                            <Path x:Name="ZoomOutIcon"
                                  Fill="White"
                                  Visibility="Collapsed"
                                  Data="M10.5,3.75 A6.75,6.75 0 1 0 10.5,17.25 A6.75,6.75 0 0 0 10.5,3.75 M2.25,10.5 A8.25,8.25 0 1 1 16.84,15.78 L21.53,20.47 A0.75,0.75 0 1 1 20.47,21.53 L15.78,16.84 A8.25,8.25 0 0 1 2.25,10.5 M6.75,10.5 A0.75,0.75 0 0 1 7.5,9.75 L13.5,9.75 A0.75,0.75 0 0 1 13.5,11.25 L7.5,11.25 A0.75,0.75 0 0 1 6.75,10.5 Z"/>
                        </Grid>
                    </Viewbox>
                </StackPanel>
            </Button>

            <!-- Site Data -->
            <Button x:Name="SiteDataButton" Grid.Column="5" Width="28" Height="28" Margin="4,0,0,0"
                    Style="{StaticResource IconHoverButtonStyle}" Padding="4" Cursor="Hand"
                    ToolTip="Cookies et données du site" Click="SiteDataButton_Click">
                <Button.ContextMenu>
                    <ContextMenu x:Name="SiteDataContextMenu"
                                 Background="#2D2D30" Foreground="White" BorderBrush="#3E3E42"
                                 Opened="SiteDataContextMenu_Opened">
                        <MenuItem x:Name="CurrentSiteDataHostMenuItem" Header="Site indisponible" IsEnabled="False"/>
                        <Separator/>
                        <MenuItem x:Name="ClearCurrentSiteDataMenuItem"
                                  Header="Supprimer les cookies et données du site"
                                  Click="ClearCurrentSiteData_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Fill="White"
                          Data="M18.75 12.75h1.5a.75.75 0 0 0 0-1.5h-1.5a.75.75 0 0 0 0 1.5ZM12 6a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5A.75.75 0 0 1 12 6ZM12 18a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5A.75.75 0 0 1 12 18ZM3.75 6.75h1.5a.75.75 0 1 0 0-1.5h-1.5a.75.75 0 0 0 0 1.5ZM5.25 18.75h-1.5a.75.75 0 0 1 0-1.5h1.5a.75.75 0 0 1 0 1.5ZM3 12a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5A.75.75 0 0 1 3 12ZM9 3.75a2.25 2.25 0 1 0 0 4.5 2.25 2.25 0 0 0 0-4.5ZM12.75 12a2.25 2.25 0 1 1 4.5 0 2.25 2.25 0 0 1-4.5 0ZM9 15.75a2.25 2.25 0 1 0 0 4.5 2.25 2.25 0 0 0 0-4.5Z"/>
                </Viewbox>
            </Button>

            <!-- AdBlocker -->
            <Button x:Name="AdBlockerButton" Grid.Column="6" Width="28" Height="28" Margin="4,0,0,0"
                    Style="{StaticResource IconHoverButtonStyle}" Padding="4" Cursor="Hand"
                    ToolTip="Boucliers Mundo Browser" Click="AdBlockerButton_Click">
                <Button.ContextMenu>
                    <ContextMenu x:Name="AdBlockerContextMenu"
                                 Background="#2D2D30" Foreground="White" BorderBrush="#3E3E42"
                                 Opened="AdBlockerContextMenu_Opened">
                        <MenuItem Header="Bloqueur de publicités" IsCheckable="True" IsChecked="{Binding IsAdBlockerEnabled}"/>
                        <MenuItem Header="Bloqueur de cookies" IsCheckable="True" IsChecked="{Binding IsCookieBlockerEnabled}"/>
                        <Separator/>
                        <MenuItem x:Name="CurrentSiteProtectionMenuItem"
                                  Header="Désactiver sur ce site"
                                  Click="ToggleCurrentSiteProtection_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Fill="Transparent"
                          Stroke="White"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Data="M9,12.75 L11.25,15 L15,9.75 M12,2.714 A11.959,11.959 0 0 1 3.598,6 A11.99,11.99 0 0 0 3,9.749 C3,15.341 6.824,20.039 12,21.372 C17.176,20.04 21,15.342 21,9.75 C21,8.44 20.79,7.179 20.402,5.999 L20.25,5.999 C17.054,5.999 14.15,4.751 12,2.714 Z">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdBlockerEnabled}" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Viewbox>
            </Button>

            <!-- Extensions Icons -->
            <ItemsControl Grid.Column="7" ItemsSource="{Binding InstalledExtensions}" VerticalAlignment="Center" Margin="10,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="28" Height="28" Margin="2,0" Padding="4"
                                Style="{StaticResource IconHoverButtonStyle}"
                                ToolTip="{Binding Name}" Cursor="Hand" Click="ExtensionIcon_Click" Tag="{Binding Id}">
                            <Button.ContextMenu>
                                <ContextMenu Background="#2D2D30" Foreground="White" BorderBrush="#3E3E42">
                                    <MenuItem Header="Supprimer l'extension" Click="RemoveExtension_Click" Tag="{Binding Id}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Grid>
                                <Image Source="{Binding IconSource}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers><DataTrigger Binding="{Binding IconSource}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Fill="Transparent"
                                          Stroke="White"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M14.25,6.087 C14.25,5.732 14.436,5.411 14.651,5.128 C14.872,4.838 15,4.494 15,4.125 C15,3.089 13.993,2.25 12.75,2.25 C11.507,2.25 10.5,3.09 10.5,4.125 C10.5,4.494 10.628,4.838 10.849,5.128 C11.064,5.411 11.25,5.732 11.25,6.087 A0.64,0.64 0 0 1 10.593,6.73 A48.39,48.39 0 0 1 6.43,6.43 C6.616,8.043 6.723,9.68 6.745,11.337 A0.656,0.656 0 0 1 6.087,12 C5.732,12 5.411,11.814 5.128,11.599 A1.647,1.647 0 0 0 4.125,11.25 C3.089,11.25 2.25,12.257 2.25,13.5 C2.25,14.743 3.09,15.75 4.125,15.75 C4.494,15.75 4.838,15.622 5.128,15.401 C5.411,15.186 5.732,15 6.087,15 C6.397,15 6.642,15.26 6.619,15.57 A48.039,48.039 0 0 1 5.977,20.626 C7.495,20.816 9.035,20.935 10.593,20.98 A0.64,0.64 0 0 0 11.25,20.337 C11.25,19.982 11.064,19.661 10.849,19.378 A1.647,1.647 0 0 1 10.5,18.375 C10.5,17.34 11.508,16.5 12.75,16.5 C13.993,16.5 15,17.34 15,18.375 C15,18.744 14.872,19.088 14.651,19.378 C14.436,19.661 14.251,19.982 14.251,20.337 C14.251,20.67 14.528,20.936 14.861,20.917 A48.1,48.1 0 0 0 20.288,20.287 A48.05,48.05 0 0 0 20.87,15.57 A0.532,0.532 0 0 0 20.337,15 C19.982,15 19.661,15.186 19.378,15.401 C19.088,15.622 18.744,15.75 18.375,15.75 C17.34,15.75 16.5,14.743 16.5,13.5 C16.5,12.257 17.34,11.25 18.375,11.25 C18.745,11.25 19.088,11.378 19.378,11.599 C19.661,11.814 19.982,12 20.338,12 A0.656,0.656 0 0 0 20.996,11.337 A48.422,48.422 0 0 0 20.626,5.977 C18.74,6.319 16.816,6.551 14.86,6.666 A0.578,0.578 0 0 1 14.25,6.087 Z">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Viewbox>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Rectangle Grid.Column="8"
                       Width="1"
                       Height="20"
                       Margin="5,0,28,0"
                       VerticalAlignment="Center"
                       Fill="#38FFFFFF"
                       IsHitTestVisible="False"/>

        </Grid>
    </Border>
</UserControl>
