<UserControl x:Class="MundoBrowser.SidebarMediaBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MundoBrowser"
             KeyboardNavigation.TabNavigation="None">
    <UserControl.Resources>
        <Style x:Key="MediaButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="MediaBar"
            Background="#880A0A0A"
            CornerRadius="12"
            Margin="10,5,10,10"
            Padding="12,10"
            VerticalAlignment="Bottom">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding ActiveMediaTab, Converter={x:Static local:Converters.NullToBool}}" Value="True"/>
                            <Condition Binding="{Binding IsMediaBarVisible}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid DataContext="{Binding ActiveMediaTab}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="ExpandedInfo" Opacity="0" Height="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource MediaButtonStyle}"
                        Command="{Binding DataContext.CloseMediaBarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,-5,-5,0">
                    <Path Data="M0,0 L8,8 M0,8 L8,0"
                          Stroke="#666"
                          StrokeThickness="1.5"
                          Stretch="Uniform"
                          Width="8"
                          Height="8"/>
                </Button>

                <StackPanel Grid.Row="1" Margin="0,0,20,0">
                    <TextBlock Text="{Binding MediaTitle}"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding MediaArtist}"
                               Foreground="#888"
                               FontSize="11"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,15,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="{Binding MediaPositionText}" Foreground="#CC8888" FontSize="10" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding MediaDurationText}" Foreground="#888" FontSize="10" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Grid.Row="1"
                            Value="{Binding MediaProgressRatio}"
                            Height="20"
                            Margin="0,-5,0,0"
                            Minimum="0"
                            Maximum="100"
                            VerticalAlignment="Center"
                            Thumb.DragStarted="OnMediaSliderDragStarted"
                            Thumb.DragCompleted="OnMediaSliderDragCompleted">
                        <Slider.Resources>
                            <Style TargetType="{x:Type RepeatButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </Slider.Resources>
                        <Slider.Style>
                            <Style TargetType="Slider">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Slider">
                                            <Grid>
                                                <Border Background="#333" Height="3" CornerRadius="1.5" VerticalAlignment="Center"/>
                                                <Track x:Name="PART_Track">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton>
                                                            <Border Background="#883333" Height="3" CornerRadius="1.5"/>
                                                        </RepeatButton>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb Width="8" Height="8">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Ellipse Fill="White" Width="8" Height="8"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Slider.Style>
                    </Slider>
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="24"
                        Height="24"
                        CornerRadius="12"
                        ClipToBounds="True"
                        Background="#1A1A1A"
                        VerticalAlignment="Center">
                    <Path Data="{StaticResource IconMediaMusic}"
                          Fill="#FF4444"
                          Width="14"
                          Height="14"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource MediaButtonStyle}"
                            Command="{Binding DataContext.MediaPreviousCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Path Data="{StaticResource IconMediaPrev}" Fill="#CCC" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <Button Style="{StaticResource MediaButtonStyle}"
                            Margin="15,0"
                            Command="{Binding DataContext.MediaPlayPauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Path Fill="White" Width="14" Height="14" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource IconMediaPause}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMediaPaused}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource IconMediaPlay}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <Button Style="{StaticResource MediaButtonStyle}"
                            Command="{Binding DataContext.MediaNextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Path Data="{StaticResource IconMediaNext}" Fill="#CCC" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource MediaButtonStyle}"
                        Command="{Binding DataContext.MediaVolumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Path Fill="#AAA" Width="12" Height="12" Stretch="Uniform">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource IconMediaVolume}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMediaMuted}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource IconMediaMuted}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
            </Grid>
        </Grid>

        <Border.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ExpandedInfo" Storyboard.TargetProperty="Height" To="100" Duration="0:0:0.3">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="ExpandedInfo" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ExpandedInfo" Storyboard.TargetProperty="Height" To="0" Duration="0:0:0.3">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="ExpandedInfo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
    </Border>
</UserControl>
